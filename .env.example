# --- Database ---
# Leave unset for a local SQLite file at ./data/shul.db (great for a single server).
# For serverless hosting (Vercel), create a free Turso database and set both:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# --- Sessions ---
# Any long random string. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Stripe (donations) ---
# Leave blank and the site runs in "manual only" mode: pledges are recorded,
# card payment buttons are hidden, treasurer logs cash/check/Zelle by hand.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL of the site, used for Stripe redirect back after payment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Display board ---
# Optional PIN to keep the /display board from being casually browsed. Blank = open.
DISPLAY_PIN=
